# Add API keys only in your local .env, deployment secrets, or Settings.
# Never commit real API keys, tokens, webhook URLs, signing secrets, or private data.
# GOOGLE_API_KEY=
# GOOGLE_SEARCH_CX=

# Gemini — used for AI image generation in slides
# GEMINI_API_KEY=

# Brandfetch — used for brand logo and color lookups
# BRANDFETCH_CLIENT_ID=

# Logo.dev — alternative logo provider
# LOGO_DEV_TOKEN=
# LOGO_DEV_SECRET_KEY=

# Database — defaults to local SQLite (file:./data/app.db)
# Set to a remote URL for cloud database (e.g. libsql://your-db.turso.io)
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# --- Hosted deployment (Vercel) ---
# Auth: Better Auth with GitHub OAuth. Required in production; local dev can
# instead set AUTH_DISABLED=true.
# BETTER_AUTH_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# File storage for slide images and screenshots (Vercel Blob). Local dev
# falls back to data/uploads-public/ automatically.
# BLOB_READ_WRITE_TOKEN=

# Users bring their own OpenAI key via Settings for slide/image generation —
# no server-side OpenAI key is needed. GEMINI_API_KEY above remains an
# optional server-wide fallback for self-hosters.

# Server error tracking (optional). Without a DSN the Sentry plugin is a
# no-op. NEVER set AUTH_DISABLED in production — the server refuses to boot
# if it is set there (see server/plugins/production-guards.ts).
# SENTRY_DSN=

# Anthropic prompt caching for the agent loop — 1h TTL cuts repeated-prefix
# input cost roughly 10x on active threads. Recommended in production.
# AGENT_PROMPT_CACHE_TTL=1h

# App-provided Claude access: setting this makes every signed-in user's chat
# run on YOUR key. The free-tier budget below activates automatically when
# it is set — see docs/PRODUCTION.md for the full runbook.
# ANTHROPIC_API_KEY=

# Per-user monthly AI allowance on the app-provided key, in US cents.
# Default 300 ($3). 0 disables enforcement (uncapped spend).
# FREE_TIER_MONTHLY_BUDGET_CENTS=300

# Bound the worst-case single agent run (core defaults: 400 iterations /
# 20M input tokens are too generous for owner-paid keys).
# AGENT_MAX_ITERATIONS=120
# AGENT_MAX_RUN_INPUT_TOKENS=3000000
# SLIDES_RUN_SOFT_TIMEOUT_MS=480000

# Prefer user-saved keys over the Builder gateway.
# AGENT_ENGINE_PREFER_BYO_KEY=1
